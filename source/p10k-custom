# Segment implementation
function prompt_uv_project() {
  if [[ -n "$UV_PROJECT_ACTIVE" ]]; then
    local PROJ="$UV_PROJECT_PATH"
    local PYFILE="$PROJ/.python-version"

    local PINNED=""
    [[ -f "$PYFILE" ]] && PINNED="$(tr -d '[:space:]' < "$PYFILE")"

    local ACTUAL_FULL="$(get_python_version "$PROJ")"
    local ACTUAL_SHORT="${ACTUAL_FULL%.*}"

    local UV_FULL="$(cd "$PROJ" && uv run python --version 2>/dev/null | awk '{print $2}')"
    local UV_SHORT="${UV_FULL%.*}"

    local DISPLAY=""

    if [[ "$PINNED" != "$ACTUAL_SHORT" || "$PINNED" != "$UV_SHORT" ]]; then
      DISPLAY="unsynced"
    else
      DISPLAY="$ACTUAL_FULL"
    fi

    export UV_PROJECT_PYTHON="$DISPLAY"

    typeset -g POWERLEVEL9K_VCS_DISABLED=false
    p10k segment -i '' -t " $UV_PROJECT_NAME ($DISPLAY) ⚡"
  else
    typeset -g POWERLEVEL9K_VCS_DISABLED=true
  fi
}

if [[ -z "${POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS[(r)uv_project]}" ]]; then
  local idx=${POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS[(i)virtualenv]}

  if (( idx <= ${#POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS[@]} )); then
    POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(
      "${POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS[@]:1:${idx}}"
      uv_project
      "${POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS[@]:$((idx+1))}"
    )
  else
    POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS+=(
      uv_project
    )
  fi
fi


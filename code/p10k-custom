# qs-env p10k segment: shows the active uv project and its Python version.
# Requires UV_PROJECT_* env vars set by the `qs` shell function.
#
# The segment name `uv_project` must appear in
# POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS inside ~/.p10k.zsh — install.sh
# inserts it there (right after `virtualenv`). We deliberately do NOT
# mutate that array at runtime: it is fragile (sourcing order, p10k
# reload semantics, zsh-version slice quirks) and silently corrupts or
# drops neighbouring segments when wrong.

function prompt_uv_project() {
  if [[ -n "$UV_PROJECT_ACTIVE" ]]; then
    local PROJ="$UV_PROJECT_PATH"
    local PYFILE="$PROJ/.python-version"
    local VENV="$PROJ/.venv"

    local PINNED=""
    local ACTUAL_FULL=""
    local ACTUAL_SHORT=""
    local PINNED_SHORT=""
    local DISPLAY="unsynced"

    [[ -f "$PYFILE" ]] && \
      PINNED="$(tr -d '[:space:]' < "$PYFILE")"

    if [[ -x "$VENV/bin/python" ]]; then
      ACTUAL_FULL="$("$VENV/bin/python" --version 2>/dev/null | awk '{print $2}')"
    elif [[ -x "$VENV/bin/python3" ]]; then
      ACTUAL_FULL="$("$VENV/bin/python3" --version 2>/dev/null | awk '{print $2}')"
    fi

    if [[ -n "$PINNED" && -n "$ACTUAL_FULL" ]]; then
      if [[ "$PINNED" == *.*.* ]]; then
        [[ "$PINNED" == "$ACTUAL_FULL" ]] && \
          DISPLAY="$ACTUAL_FULL"
      else
        PINNED_SHORT="$(printf '%s\n' "$PINNED" |
          awk -F. '{if (NF >= 2) print $1 "." $2}')"
        ACTUAL_SHORT="$(printf '%s\n' "$ACTUAL_FULL" |
          awk -F. '{if (NF >= 2) print $1 "." $2}')"

        if [[ -n "$PINNED_SHORT" &&
              "$PINNED_SHORT" == "$ACTUAL_SHORT" ]]; then
          DISPLAY="$ACTUAL_FULL"
        fi
      fi
    fi

    export UV_PROJECT_PYTHON="$DISPLAY"

    p10k segment -i '' -t " $UV_PROJECT_NAME ($DISPLAY) ⚡"
  fi
}
